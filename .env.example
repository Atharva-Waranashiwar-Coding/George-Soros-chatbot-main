# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ============================================================
# REQUIRED: Google Generative AI Configuration
# ============================================================
# Get your free API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative environment variable name (both work)
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================
# Django Configuration
# ============================================================
# Set to False in production
DEBUG=True

# Update this with your actual domain in production
ALLOWED_HOSTS=localhost,127.0.0.1

# Update this for production (generate a strong secret key)
SECRET_KEY=django-insecure-your-secret-key-here

# ============================================================
# CORS Configuration
# ============================================================
# Frontend URL (where React app is running)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ============================================================
# Database Configuration (optional)
# ============================================================
# Django uses SQLite by default, but you can configure PostgreSQL, MySQL, etc.
# DATABASE_URL=postgresql://user:password@localhost:5432/soros_db

# ============================================================
# Logging Configuration (optional)
# ============================================================
LOG_LEVEL=INFO
